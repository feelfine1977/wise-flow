{
  "description": "Selectors of the interactive DOM map and the panels around it: every part carries data-wf-part, and where listed data-wf-kind and data-wf-state (space-separated). Removing a part, kind or state is a breaking change. See docs/API.md, section 'Styling contract'.",
  "states": ["selected", "focused", "hovered", "dimmed", "outOfScope", "reconnected"],
  "parts": {
    "map": {},
    "node": { "kinds": ["activity", "stage", "gateway", "event", "note"], "states": ["selected", "focused", "hovered", "dimmed", "outOfScope", "reconnected"] },
    "node-band": {},
    "node-cue": {},
    "node-cue-foot": {},
    "node-label": {},
    "node-count": {},
    "group": { "kinds": ["stage", "lane", "pool"], "states": ["selected"] },
    "group-label": {},
    "edge": { "kinds": ["follows", "constraint", "flow"], "states": ["selected", "focused", "hovered", "dimmed", "reconnected"] },
    "edge-path": {},
    "edge-label": {},
    "mark": { "kinds": ["badge", "chip", "arc", "selfLoop", "hatch"], "states": ["hovered"] },
    "controls": {},
    "button": {},
    "zoom-level": {},
    "abstraction-panel": {},
    "legend": {},
    "status": {},
    "menu": {},
    "menu-item": { "states": ["focused"] },
    "tooltip": {},
    "table": {},
    "table-row": { "states": ["selected"] },
    "filters": {},
    "filter-chip": {},
    "path-list": {},
    "timeline": {},
    "timeline-event": {}
  }
}
